# NOT loaded by docker-compose. This is the vhost block for the Caddy already
# running on the HOST (systemd), which terminates TLS for every app on that
# box. Append it to /etc/caddy/Caddyfile — do not overwrite that file, the
# other sites are defined in it.
#
#   sudo cp /etc/caddy/Caddyfile /etc/caddy/Caddyfile.bak
#   sudo nano /etc/caddy/Caddyfile        # paste the two blocks below
#   sudo caddy validate --config /etc/caddy/Caddyfile
#   sudo systemctl reload caddy
#
# Run validate BEFORE reloading. A syntax error here stops Caddy loading and
# takes gymwebsite and crateflow down with it, not just this site.
#
# Both names must already resolve to this server before reloading, or
# certificate issuance fails and Caddy backs off for a while.

fynboscreative.co.za {
	# Matches the loopback port published by docker-compose.yml.
	reverse_proxy 127.0.0.1:8080

	# The site container serves plain HTTP and cannot know the request arrived
	# over TLS, so HSTS belongs here rather than in nginx.conf.
	#
	# This is a COMMITMENT: for the next year browsers that have seen this
	# header refuse to load the domain over plain HTTP, with no click-through
	# for visitors. Back it out by serving max-age=0 and waiting for caches to
	# expire — it cannot be recalled retroactively. While you are still
	# testing DNS or certificates, drop max-age to 300.
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
}

# One canonical host, for SEO: serving identical content on both www and apex
# splits ranking signals. 301 is what search engines need to consolidate.
www.fynboscreative.co.za {
	redir https://fynboscreative.co.za{uri} permanent
}
